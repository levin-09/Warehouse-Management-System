# Voice AI — speech to text, LLM, and text to speech
DEEPGRAM_API_KEY=
# Groq powers the voice LLM (OpenAI-compatible). Get a key from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# WMS backend this voice bot talks to (for reads and actions)
WMS_BASE_URL=http://localhost:8000/v1

# A WMS service account the bot uses to execute actions (record receipts,
# ship orders). Use a dedicated 'admin' user, not the default bootstrap admin.
WMS_SERVICE_EMAIL=voicebot@whitfield.com
WMS_SERVICE_PASSWORD=replace-me
