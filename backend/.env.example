# ---- App ----
APP_NAME=Whitfield WMS API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/v1
HOST=0.0.0.0
PORT=8000

# ---- Security ----
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---- Database (MongoDB) ----
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=whitfield_wms

# ---- AI (chatbot / voice) ----
# Groq powers the WMS chatbot agent. Get a key from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Scheduler ----
# Enable/disable the periodic automation jobs (non-AI).
ENABLE_SCHEDULER=true

# ---- Notifications (email/SMS) ----
# Placeholder providers. The notification service writes to MongoDB
# regardless; outbound email/SMS requires a provider client.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL_FROM=notifications@whitfieldfulfillment.com
